<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <include layout="@layout/page_top"/>

        <LinearLayout
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/header"/>

            <!-- URL bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp">

                <EditText
                    android:id="@+id/browser_url"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="Search or enter URL"
                    android:textColorHint="#888888"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@null"
                    android:imeOptions="actionGo"
                    android:singleLine="true"/>

                <ImageView
                    android:id="@+id/browser_go"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_go"
                    android:contentDescription="Go"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/browser_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:max="100"
                android:progress="0"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp">

                <WebView
                    android:id="@+id/browser_webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:id="@+id/browser_home"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:id="@+id/history_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent sites"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#aaaaaa"/>

                    <ListView
                        android:id="@+id/history_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="6dp"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="6dp"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Detected media -->
            <TextView
                android:id="@+id/media_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:text="Media found"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#aaaaaa"
                android:visibility="gone"/>

            <ListView
                android:id="@+id/media_list"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/fab_osd"/>
</FrameLayout>
